# e-Netra AI / Drishti - Notification Configuration
# Copy this template to .env. Never commit the actual .env file.

# Notification mode: demo | live
# Keep demo until live email delivery is properly configured.
NOTIFICATION_MODE=demo

# Email provider: demo | resend
EMAIL_PROVIDER=demo

# Resend API key - keep blank in this template.
RESEND_API_KEY=

# Resend test sender only. Production requires a verified sending domain.
EMAIL_FROM=onboarding@resend.dev

# SMS provider: demo
# MSG91 integration is not implemented yet.
SMS_PROVIDER=demo
